{
  "name": "citgm",
  "version": "10.0.2",
  "description": "The Canary in the Goldmine",
  "homepage": "https://nodejs.org",
  "preferGlobal": true,
  "type": "module",
  "exports": false,
  "bin": {
    "citgm": "bin/citgm.js",
    "citgm-all": "bin/citgm-all.js"
  },
  "files": [
    "bin",
    "lib",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint:eslint": "eslint --cache",
    "lint:eslint:fix": "npm run lint:eslint -- --fix",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "tap": "tap run \"test/**/test-*.js\"",
    "test": "npm run lint && npm run tap"
  },
  "author": "James M Snell <jasnell@gmail.com> (http://jasnell.me)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodejs/citgm.git"
  },
  "bugs": {
    "url": "https://github.com/nodejs/citgm/issues",
    "email": "jasnell@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@npmcli/package-json": "^8.0.0",
    "async": "^3.2.6",
    "bl": "^7.0.12",
    "chalk": "^6.0.0",
    "columnify": "^1.6.0",
    "execa": "^10.0.1",
    "lodash": "^4.18.1",
    "normalize-git-url": "^3.0.2",
    "npm-package-arg": "^14.0.0",
    "npm-which": "^3.0.1",
    "pnpm": "^11.24.0",
    "root-check": "^2.0.0",
    "semver": "^7.8.5",
    "strip-ansi": "^7.2.0",
    "supports-color": "^11.0.0",
    "tar": "^7.5.22",
    "uid-number": "0.0.6",
    "undici": "^8.10.0",
    "which": "^7.0.0",
    "winston": "^3.19.0",
    "xml-sanitizer": "^3.0.0",
    "xmlbuilder": "^15.1.1",
    "yargs": "^18.1.0",
    "yarn": "^1.22.22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ansi-regex": "^6.3.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "string-to-stream": "^3.0.1",
    "tap": "^21.7.5",
    "tap-parser": "^18.3.4",
    "xml2js": "^0.6.2"
  },
  "prettier": {
    "proseWrap": "always",
    "singleQuote": true,
    "trailingComma": "none",
    "overrides": [
      {
        "files": "LICENSE.md",
        "options": {
          "proseWrap": "never"
        }
      }
    ]
  },
  "tap": {
    "timeout": 480,
    "allow-incomplete-coverage": true
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
